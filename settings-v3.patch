+.dashboard-shell .notification-item i { width: 5px; height: 5px; border-radius: 50%; background: #323232; margin-top: 5px; flex-shrink: 0; }
+.dashboard-shell .notification-empty { margin: 0; padding: 22px 18px; font-size: .75rem; line-height: 1.6; color: #898989; }
+.dashboard-shell .toast.notice-error > span, .dashboard-shell .toast.notice-critical > span { color: #b43d35; background: #fff0ee; }
