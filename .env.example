# --- Инфраструктура ---
# Для локального запуска вне Docker (когда db и redis запущены через docker compose up -d db redis):
DATABASE_URL=postgresql+psycopg://postgres:secret_password@localhost:5432/b2b_procurement
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
CORS_ORIGINS=*

# --- LLM (OpenAI-совместимый API: OpenRouter, vLLM, YandexGPT, Ollama, OpenAI) ---
# Оставьте пустым для работы в эвристическом режиме без LLM:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct
LLM_CONCURRENCY=6
LLM_JSON_MODE=true

# --- Эмбеддинги (OpenAI-совместимый /embeddings) ---
# Оставьте пустым для локальных хэш-эмбеддингов без внешних сервисов:
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_SEND_DIMENSIONS=false

# --- OCR и Воркер ---
OCR_THREADS=4
WORKER_CONCURRENCY=2

# --- Оффлайн-анализ (при пустом LLM_BASE_URL) ---
# HEURISTIC_ENGINE=nli (модель анализа противоречий) или keyword (поиск по стеммам)
HEURISTIC_ENGINE=nli
NLI_MODEL_NAME=cointegrated/rubert-base-cased-nli-threeway
NLI_THRESHOLD=0.5
NLI_QUANTIZE=true
