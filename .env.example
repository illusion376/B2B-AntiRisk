# Скопируйте в .env и заполните. Без LLM_BASE_URL система работает в эвристическом режиме
# (поиск релевантных пунктов без оценки ИИ) — удобно для разработки фронтенда.

# --- Вариант 1: внешний OpenAI-совместимый API (OpenRouter, vLLM, YandexGPT, OpenAI...) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen/qwen-2.5-72b-instruct

# --- Вариант 2: локально через Ollama (docker compose --profile local-llm up --build) ---
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# EMBEDDING_BASE_URL=http://ollama:11434/v1
# EMBEDDING_MODEL=bge-m3

# Эмбеддинги должны иметь размерность 1024 (колонка vector(1024)): bge-m3, multilingual-e5-large,
# или text-embedding-3-small/large с EMBEDDING_SEND_DIMENSIONS=true
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_SEND_DIMENSIONS=false

# Параллелизм
# LLM_CONCURRENCY=6
# WORKER_CONCURRENCY=2
# OCR_THREADS=4

# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
