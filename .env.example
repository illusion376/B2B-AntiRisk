# --- Инфраструктура ---
# Для локального запуска вне Docker (когда db и redis запущены через docker compose up -d db redis):
DATABASE_URL=postgresql+psycopg://postgres:secret_password@localhost:5432/b2b_procurement
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
CORS_ORIGINS=*

# Режим по умолчанию: auto, llm, keyword. Выбор в интерфейсе: «Настройки».
# auto: LLM при заполненных URL, модели и ключе, иначе поиск по словам.
ANALYSIS_ENGINE=auto

# --- LLM через ProxyAPI (https://proxyapi.ru/docs/api-overview) ---
# Ключ из кабинета ProxyAPI; без него LLM недоступна. Не добавляйте ключ в git.
LLM_BASE_URL=https://api.proxyapi.ru/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini
LLM_CONCURRENCY=6
LLM_JSON_MODE=true
LLM_TIMEOUT_S=120
# Для GPT-5/o-series лимит включает рассуждения и итоговый JSON.
LLM_MAX_TOKENS=8192
LLM_REASONING_EFFORT=low
# Число отобранных фрагментов на правило; это не проверка всего документа.
RETRIEVAL_TOP_K=4

# --- Эмбеддинги (OpenAI-совместимый /embeddings) ---
# Оставьте пустым для локальных хэш-эмбеддингов без внешних сервисов:
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_SEND_DIMENSIONS=false

# --- OCR и Воркер ---
OCR_THREADS=4
WORKER_CONCURRENCY=2

# --- Поиск по словам без моделей (если LLM не настроена) ---
# NLI и Ollama исключены из сборки; локальные модели не скачиваются.
HEURISTIC_ENGINE=keyword
